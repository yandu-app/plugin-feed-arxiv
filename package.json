{
  "name": "@yandu/plugin-feed-arxiv",
  "version": "1.0.0",
  "description": "Yandu plugin: arXiv Feed",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "yandu-feed-arxiv": "./dist/worker.js" },
  "yandu": { "main": "./dist/index.js", "worker": "./dist/worker.js", "protocol": "jsonl-v1" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/worker.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@yandu/types": "workspace:*",
    "typescript": "^5.6.0"
  },
  "publishConfig": { "access": "public" }
}
